{
	"name": "colymba/colorfield",
	"type": "silverstripe-vendormodule",
	"description": "SilverStripe 5 Color picker and DBField field with attitude.",
	"keywords": ["silverstripe", "silverstripe 5", "color", "colour", "color picker", "colour field", "DBField"],
	"license": "BSD-3-Clause",
	"authors": [{
		"name": "Thierry Francois",
		"email": "thierry@colymba.com"
	}, {
		"name": "Chrometoaster",
		"email": "hello@chrometoaster.com"
	}],
	"require": {
		"php": "^8.1",
		"silverstripe/framework": "^5.4"
	},
	"autoload": {
